/* =========================================================
   MODEL
========================================================= */

class ClothingItem {
  final String id;
  String name;
  String category;
  String color;
  String season;
  String occasion;
  double price;
  int timesWorn;
  bool favorite;

  ClothingItem({
    required this.id,
    required this.name,
    required this.category,
    required this.color,
    required this.season,
    required this.occasion,
    required this.price,
    this.timesWorn = 0,
    this.favorite = false,
  });

  double get costPerWear {
    if (timesWorn == 0) return price;
    return price / timesWorn;
  }
}

/* =========================================================
   APP STATE
   No provider package required
========================================================= */

class WardrobeState extends ChangeNotifier {
  final List<ClothingItem> items = [
    ClothingItem(
      id: '1',
      name: 'White T-Shirt',
      category: 'T-Shirt',
      color: 'White',
      season: 'Summer',
      occasion: 'Casual',
      price: 700,
      timesWorn: 12,
    ),
    ClothingItem(
      id: '2',
      name: 'Blue Jeans',
      category: 'Jeans',
      color: 'Blue',
      season: 'All Season',
      occasion: 'Casual',
      price: 1800,
      timesWorn: 20,
    ),
    ClothingItem(
      id: '3',
      name: 'Black Shirt',
      category: 'Shirt',
      color: 'Black',
      season: 'All Season',
      occasion: 'Formal',
      price: 1400,
      timesWorn: 8,
    ),
    ClothingItem(
      id: '4',
      name: 'Denim Jacket',
      category: 'Jacket',
      color: 'Blue',
      season: 'Winter',
      occasion: 'Casual',
      price: 2800,
      timesWorn: 6,
    ),
    ClothingItem(
      id: '5',
      name: 'Black Sneakers',
      category: 'Shoes',
      color: 'Black',
      season: 'All Season',
      occasion: 'Casual',
      price: 2200,
      timesWorn: 25,
    ),
    ClothingItem(
      id: '6',
      name: 'Beige Chinos',
      category: 'Pants',
      color: 'Beige',
      season: 'Summer',
      occasion: 'Formal',
      price: 1900,
      timesWorn: 5,
    ),
  ];

  void addItem(ClothingItem item) {
    items.add(item);
    notifyListeners();
  }

  void removeItem(String id) {
    items.removeWhere((item) => item.id == id);
    notifyListeners();
  }

  void toggleFavorite(String id) {
    final item = items.firstWhere((e) => e.id == id);
    item.favorite = !item.favorite;
    notifyListeners();
  }

  void markWorn(String id) {
    final item = items.firstWhere((e) => e.id == id);
    item.timesWorn++;
    notifyListeners();
  }

  double get totalValue {
    return items.fold(0, (sum, item) => sum + item.price);
  }

  int get totalWears {
    return items.fold(0, (sum, item) => sum + item.timesWorn);
  }

  double get averageCostPerWear {
    if (items.isEmpty) return 0;
    return items.fold(
      0.0,
          (sum, item) => sum + item.costPerWear,
    ) /
        items.length;
  }

  ClothingItem? get mostWorn {
    if (items.isEmpty) return null;
    return items.reduce(
          (a, b) => a.timesWorn > b.timesWorn ? a : b,
    );
  }

  ClothingItem? get leastWorn {
    if (items.isEmpty) return null;
    return items.reduce(
          (a, b) => a.timesWorn < b.timesWorn ? a : b,
    );
  }
}

