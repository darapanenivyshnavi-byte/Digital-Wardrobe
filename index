class PackingScreen extends StatefulWidget {
  final WardrobeState wardrobe;

  const PackingScreen({
    super.key,
    required this.wardrobe,
  });

  @override
  State<PackingScreen> createState() =>
      _PackingScreenState();
}

class _PackingScreenState
    extends State<PackingScreen> {
  int days = 3;

  List<String> packing = [];

  @override
  void initState() {
    super.initState();
    generatePacking();
  }

  void generatePacking() {
    final items = widget.wardrobe.items;

    packing = [
      ...items
          .where(
            (e) =>
        e.category == 'T-Shirt' ||
            e.category == 'Shirt',
      )
          .take(min(days, 4))
          .map((e) => e.name),
      ...items
          .where(
            (e) =>
        e.category == 'Jeans' ||
            e.category == 'Pants',
      )
          .take(2)
          .map((e) => e.name),
      'Toiletries',
      'Charger',
      'Power Bank',
      'Sunglasses',
    ];

    setState(() {});
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title:
        const Text('Smart Packing'),
      ),
      body: ListView(
        padding:
        const EdgeInsets.all(20),
        children: [
          const Text(
            'Pack smarter',
            style: TextStyle(
              fontSize: 30,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 20),

          Text(
            '$days days trip',
            style: const TextStyle(
              fontWeight: FontWeight.bold,
            ),
          ),

          Slider(
            value: days.toDouble(),
            min: 1,
            max: 14,
            divisions: 13,
            label: '$days days',
            onChanged: (value) {
              setState(() {
                days = value.round();
              });
            },
          ),

          FilledButton.icon(
            onPressed: generatePacking,
            icon:
            const Icon(Icons.auto_awesome),
            label: const Text(
              'Generate Packing List',
            ),
          ),

          const SizedBox(height: 25),

          const Text(
            'Packing List',
            style: TextStyle(
              fontSize: 22,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 12),

          ...packing.map(
                (item) {
              return Card(
                color:
                const Color(0xFF171720),
                child: CheckboxListTile(
                  value: false,
                  onChanged: (_) {},
                  title: Text(item),
                  secondary: const Icon(
                    Icons.luggage_outlined,
                  ),
                ),
              );
            },
          ),
        ],
      ),
    );
